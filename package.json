{
  "name": "academic-certificate-verification",
  "version": "1.0.0",
  "description": "Solidity academic certificate verification with a web interface and PostgreSQL API",
  "main": "index.js",
  "scripts": {
    "dev:local": "node scripts/start-local.mjs",
    "sync:abi": "node scripts/sync-abi.mjs",
    "test": "hardhat test",
    "build": "hardhat build",
    "typecheck": "tsc --noEmit",
    "test:api": "npm --prefix backend test",
    "build:api": "npm --prefix backend run build",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "db:setup": "npm --prefix backend run db:setup"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.2",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.16.0",
    "mocha": "^11.8.0",
    "typescript": "~6.0.3"
  }
}
